{
  "name": "futureproof",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "demo:verify": "npm --prefix fixtures/notification-demo/candidate-a test && npm --prefix fixtures/notification-demo/candidate-b test"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "type": "module"
}
